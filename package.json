  "files": [
    "index.js",
    "src",
    "benchmark",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansari-in/iri-shield.git"
  },
  "homepage": "https://github.com/ansari-in/iri-shield#readme",
  "scripts": {
